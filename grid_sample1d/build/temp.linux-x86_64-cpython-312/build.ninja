ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-11.8/bin/nvcc

cflags = -pthread -B /home/i2slab2/.conda/envs/bppc/compiler_compat -fno-strict-overflow -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/i2slab2/.conda/envs/bppc/include -fPIC -O2 -isystem /home/i2slab2/.conda/envs/bppc/include -fPIC -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include/TH -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/i2slab2/.conda/envs/bppc/include/python3.12 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=grid_sample1d_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include/TH -I/home/i2slab2/.conda/envs/bppc/lib/python3.12/site-packages/torch/include/THC -I/usr/local/cuda-11.8/include -I/home/i2slab2/.conda/envs/bppc/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=grid_sample1d_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /home/i2slab2/oshmos/bppc/grid_sample1d/build/temp.linux-x86_64-cpython-312/grid_sample1d_cuda.o: compile /home/i2slab2/oshmos/bppc/grid_sample1d/grid_sample1d_cuda.cpp
build /home/i2slab2/oshmos/bppc/grid_sample1d/build/temp.linux-x86_64-cpython-312/grid_sample1d_cuda_kernel.o: cuda_compile /home/i2slab2/oshmos/bppc/grid_sample1d/grid_sample1d_cuda_kernel.cu






